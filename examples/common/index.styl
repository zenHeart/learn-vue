ellipse()
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

$Moblie = 800px

.app
  display flex
  padding 20px

  nav
    padding 10px 0
    position fixed
    top 0
    bottom 0
    max-width 300px
    margin-right 10px
    overflow-y auto
   

    .nav-item
      text-decoration none
      display block
      padding 2px 5px
      cursor pointer
      border-bottom 1px solid #000

      &.active
        border-bottom 1px solid #22B077

      &:hover
        background #f5fff6

  .app-content
    margin-left 310px
    flex 1
    border 1px solid #000
    padding 10px
    height 80vh
    // >iframe

@media (max-width $Moblie)
  .app
    flex-direction column

  nav
    width 100%
